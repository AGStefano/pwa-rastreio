# PostgreSQL
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/rastreio?schema=public"

# Servidor
PORT=3000

# Tiny ERP — duas contas distintas (mesma API, tokens diferentes) sincronizadas
# pro mesmo banco. O cliente final busca sem saber/escolher qual conta é.
TINY_API_TOKEN_FILAMENTO="coloque_o_token_da_conta_de_filamentos_aqui"
TINY_API_TOKEN_IMPRESSORA="coloque_o_token_da_conta_de_impressoras_aqui"
TINY_API_BASE_URL="https://api.tiny.com.br/api2/"
TINY_HTTP_TIMEOUT_MS=15000

# Olist Envios
OLIST_ENVIOS_BASE_URL="https://envios-api.olist.com/v1/bff/volumes/"
OLIST_HTTP_TIMEOUT_MS=10000

# Rate limit do Tiny (compartilhado entre todos os endpoints, mesmo token).
# Limite real é 60/min - deixamos margem de segurança.
TINY_RATE_LIMIT_PER_MINUTE=45

# Retry em caso de 429 / erro de limite excedido
TINY_RETRY_MAX_ATTEMPTS=5
TINY_RETRY_BASE_DELAY_MS=2000

# Cron de sincronização
SYNC_CRON_INTERVAL_MINUTES=45
# Margem de segurança subtraída do horário de início do cron, para não perder
# atualizações que aconteçam durante a própria execução da sincronização.
SYNC_SAFETY_MARGIN_MINUTES=5
# Usado apenas na primeira execução (quando ainda não há sync_control salvo).
# Formato dd/mm/yyyy HH:mm:ss
SYNC_INITIAL_DATE="01/01/2024 00:00:00"

# Token simples para proteger o endpoint manual de sincronização (opcional).
# Se definido, é preciso enviar o header "x-admin-token" com o mesmo valor.
ADMIN_TOKEN=""

# Origem liberada para o frontend consumir a API (CORS). "*" em dev, domínio
# específico do frontend em produção.
CORS_ORIGIN="*"
